impl -add rev_1 -type fpga

set_option -top_module eh2_veer_wrapper
set_option -vlog_std sysv
set_option -project_relative_includes 1
set_option -include_path {D:/eh2_fpga/Cores-VeeR-EH2-main/Cores-VeeR-EH2-main/design;D:/eh2_fpga/Cores-VeeR-EH2-main/Cores-VeeR-EH2-main/design/include;D:/eh2_fpga/Cores-VeeR-EH2-main/Cores-VeeR-EH2-main/design/ifu;D:/eh2_fpga/Cores-VeeR-EH2-main/Cores-VeeR-EH2-main/design/dec;D:/eh2_fpga/Cores-VeeR-EH2-main/Cores-VeeR-EH2-main/design/exu;D:/eh2_fpga/Cores-VeeR-EH2-main/Cores-VeeR-EH2-main/design/lsu;D:/eh2_fpga/Cores-VeeR-EH2-main/Cores-VeeR-EH2-main/design/dbg;D:/eh2_fpga/Cores-VeeR-EH2-main/Cores-VeeR-EH2-main/design/dmi;D:/eh2_fpga/Cores-VeeR-EH2-main/Cores-VeeR-EH2-main/design/lib}

set_option -technology Virtex-UltraScalePlus-FPGAs
set_option -part XCVU19P
set_option -package FSVA3824
set_option -speed_grade -1-e
set_option -part_companion ""

set_option -disable_io_insertion 1
set_option -frequency 50.000
set_option -fanout_limit 10000
set_option -maxfan 10000
set_option -retiming 0
set_option -resource_sharing 0
set_option -symbolic_fsm_compiler 1
set_option -compiler_compatible 0
set_option -multi_file_compilation_unit 1
set_option -write_verilog 1
set_option -write_vhdl 0
set_option -write_apr_constraint 1
set_option -rw_check_on_ram 1
set_option -enable_prepacking 1

project -result_file "rev_1/eh2_veer_wrapper.edf"
